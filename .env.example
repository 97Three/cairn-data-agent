# fake 模式完全离线，并读取 Scenario 自带的示例计划。
CAIRN_MODEL_MODE=fake

# 使用 OpenAI-compatible 服务时取消下面几行的注释。
# CAIRN_MODEL_MODE=openai-compatible
# CAIRN_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# CAIRN_MODEL_ID=your-model-id
# CAIRN_MODEL_API_KEY=

CAIRN_DATABASE_URL=sqlite:///./runtime-data/cairn.db
CAIRN_STORAGE_ROOT=./runtime-data
# 省略下面两项时使用发行包内置资源；只把 Skill root 指向你已审查并信任的代码。
# CAIRN_SCENARIOS_ROOT=./scenarios
# CAIRN_SKILLS_ROOT=./skills
CAIRN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
