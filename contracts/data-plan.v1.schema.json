{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cairn:data-agent:contracts:data-plan:v1",
  "title": "Cairn Data Agent DataPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "goal", "asset_ids", "steps"],
  "properties": {
    "version": {"const": "cairn.data-plan/v1"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/inspect"},
          {"$ref": "#/$defs/filter"},
          {"$ref": "#/$defs/select"},
          {"$ref": "#/$defs/derive"},
          {"$ref": "#/$defs/aggregate"},
          {"$ref": "#/$defs/join"},
          {"$ref": "#/$defs/sort"},
          {"$ref": "#/$defs/limit"},
          {"$ref": "#/$defs/retrieve"},
          {"$ref": "#/$defs/skill"}
        ]
      }
    },
    "answer_instruction": {
      "type": "string",
      "maxLength": 1000,
      "default": "基于全部结果给出简洁结论。"
    }
  },
  "$defs": {
    "stepId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "reference": {"type": "string", "pattern": "^(asset|step):.+$"},
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "operator"],
      "properties": {
        "column": {"type": "string"},
        "operator": {
          "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "in", "is_null", "is_not_null"]
        },
        "value": {}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "operation", "alias"],
      "properties": {
        "column": {"type": "string"},
        "operation": {"enum": ["count", "sum", "mean", "min", "max", "median"]},
        "alias": {"type": "string"}
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "asset_id"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "inspect"},
        "asset_id": {"type": "string"}
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "predicates"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "filter"},
        "input": {"$ref": "#/$defs/reference"},
        "predicates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/predicate"}
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "columns"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "select"},
        "input": {"$ref": "#/$defs/reference"},
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string"}
        }
      }
    },
    "derive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "output_column", "operation", "left_column"],
      "oneOf": [
        {
          "required": ["right_column"],
          "properties": {
            "right_column": {"type": "string"},
            "right_value": {"type": "null"}
          }
        },
        {
          "required": ["right_value"],
          "properties": {
            "right_column": {"type": "null"},
            "right_value": {"type": "number"}
          }
        }
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "derive"},
        "input": {"$ref": "#/$defs/reference"},
        "output_column": {"type": "string"},
        "operation": {"enum": ["add", "subtract", "multiply", "divide"]},
        "left_column": {"type": "string"},
        "right_column": {"type": ["string", "null"], "default": null},
        "right_value": {"type": ["number", "null"], "default": null}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "metrics"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "aggregate"},
        "input": {"$ref": "#/$defs/reference"},
        "group_by": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string"},
          "default": []
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "left", "right", "left_on", "right_on"],
      "oneOf": [
        {
          "properties": {
            "left_on": {"minItems": 1, "maxItems": 1},
            "right_on": {"minItems": 1, "maxItems": 1}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 2, "maxItems": 2},
            "right_on": {"minItems": 2, "maxItems": 2}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 3, "maxItems": 3},
            "right_on": {"minItems": 3, "maxItems": 3}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 4, "maxItems": 4},
            "right_on": {"minItems": 4, "maxItems": 4}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 5, "maxItems": 5},
            "right_on": {"minItems": 5, "maxItems": 5}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 6, "maxItems": 6},
            "right_on": {"minItems": 6, "maxItems": 6}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 7, "maxItems": 7},
            "right_on": {"minItems": 7, "maxItems": 7}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 8, "maxItems": 8},
            "right_on": {"minItems": 8, "maxItems": 8}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 9, "maxItems": 9},
            "right_on": {"minItems": 9, "maxItems": 9}
          }
        },
        {
          "properties": {
            "left_on": {"minItems": 10, "maxItems": 10},
            "right_on": {"minItems": 10, "maxItems": 10}
          }
        }
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "join"},
        "left": {"$ref": "#/$defs/reference"},
        "right": {"$ref": "#/$defs/reference"},
        "left_on": {
          "type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}
        },
        "right_on": {
          "type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}
        },
        "how": {"enum": ["inner", "left"], "default": "inner"}
      }
    },
    "sortColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "column": {"type": "string"},
        "descending": {"type": "boolean", "default": false}
      }
    },
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "by"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "sort"},
        "input": {"$ref": "#/$defs/reference"},
        "by": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/sortColumn"}
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input", "count"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "limit"},
        "input": {"$ref": "#/$defs/reference"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "retrieve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "asset_ids", "query"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "retrieve"},
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string"}
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "skill"],
      "properties": {
        "id": {"$ref": "#/$defs/stepId"},
        "kind": {"const": "skill"},
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "input": {
          "oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}],
          "default": null
        },
        "arguments": {"type": "object", "default": {}}
      }
    }
  }
}
